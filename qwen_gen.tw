# qwen_gen.tw: answer a coding prompt with the Qwen2.5-Coder-0.5B runtime.
#
# Run from the repository root after `oracle fetch-qwen` has downloaded and
# converted the weights:
#
#   twill run qwen_gen.tw "Write a Python function that reverses a list."
#
# The weights are Qwen's open release; only this runtime is Twill. The prompt is
# wrapped in Qwen's ChatML template so the instruct model answers rather than
# just continuing text, and only the assistant's reply is printed. Decoding is
# read from the same ORACLE_* variables the other commands use; the defaults are
# tuned low for code (firm, not chatty).

import "std/random" as rnd
import "std/float" as float
import "std/text" as text
import "src/qwen.tw" as qwen
import "src/qwen_tok.tw" as qt

fn env_num(name, dflt) {
  match env(name) {
    Some(v) => if len(v) == 0 { dflt } else {
      match float.f64_of_str(v) {
        Some(x) => x,
        None => dflt
      }
    },
    None => dflt
  }
}

let STEPS = int(env_num("ORACLE_STEPS", 160.0))
let TEMP = env_num("ORACLE_TEMP", 0.3)
let TOPK = int(env_num("ORACLE_TOPK", 20.0))
let NUCLEUS = env_num("ORACLE_TOPP", 0.9)
let REP = env_num("ORACLE_REP", 1.0)
let SEED = int(env_num("ORACLE_SEED", 0.0))

let av = args()
let ask = if len(av) > 1 { av[1] } else { "Write a Python function that reverses a list." }

# Arguments after the prompt are file paths whose contents are given to the model
# as context, so a question can be asked about one or several real files.
fn build_prompt(ask, av) {
  let ctx = ""
  let i = 2
  while i < len(av) {
    if len(av[i]) > 0 {
      # read_file returns Res[Str, Str]; unwrap it so the file's real contents,
      # not an "Ok(...)" wrapper, go into the prompt.
      match read_file(av[i]) {
        Ok(body) => { ctx = ctx + "Here is a file named " + av[i] + ":\n\n```\n" + body + "\n```\n\n" },
        Err(e) => { ctx = ctx + "(could not read " + av[i] + ": " + e + ")\n\n" }
      }
    }
    i = i + 1
  }
  if len(ctx) > 0 { ctx + ask } else { ask }
}
let prompt = build_prompt(ask, av)

# The model directory, so a different size can be selected. bin/oracle sets
# ORACLE_QWEN_DIR from its --model flag; the default is the standard location.
fn model_dir() {
  match env("ORACLE_QWEN_DIR") {
    Some(d) => if len(d) == 0 { "models/qwen" } else { str(d) },
    None => "models/qwen"
  }
}
let dir = model_dir()
let g = qwen.load_qwen(dir + "/qwen-int8.bin")
let q = qt.load_qwen_tok(dir + "/qwen-tok.bin")
let ids = qt.chat_encode(q, prompt)
let r = rnd.new_rng(SEED)
# Stream the reply as it is generated, decoding the whole reply each step and
# printing only the new tail so multi-byte characters never split mid-print.
# This is the same technique oracle chat uses, so a one-shot task also shows its
# answer as it is written instead of after the whole generation finishes.
let shown = 0
let reply = qwen.generate_stream(g, ids, STEPS, r, TEMP, TOPK, NUCLEUS, REP, fn(rep) {
  let full = qt.decode(q, tensor(rep))
  if len(full) > shown {
    write_out(text.slice(full, shown, len(full)))
    shown = len(full)
  }
  rep
})
write_out("\n")
