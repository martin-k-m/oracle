# generate.tw: load a checkpoint and continue a prompt.
#
# Run it from the repository root:
#
#   twill run generate.tw "To be, or not to be"
#   twill run generate.tw "To be, or not to be" models/oracle-int8.bin
#
# The first argument is the prompt (a short default if omitted); the optional
# second argument is the checkpoint path (models/oracle.bin by default). Both the
# f64 checkpoint and the int8 one from quantize.tw load here: an int8 file is
# detected by its `quant` field and its packed weights are rebuilt into the int8
# inference kernel before sampling. Sampling is seeded, so a given prompt and
# checkpoint give the same continuation every run; change the seed for a
# different draw.
#
# The decoding controls are read from the environment, so `bin/oracle generate`
# can expose them as flags without a second argument-parsing scheme:
#
#   ORACLE_STEPS  tokens to generate                 (default 200)
#   ORACLE_TEMP   softmax temperature, lower firmer  (default 0.8)
#   ORACLE_TOPK   keep the top-k tokens, 0 for off   (default 40)
#   ORACLE_TOPP   nucleus (top-p) mass, 1.0 for off  (default 0.95)
#   ORACLE_REP    repetition penalty, 1.0 for off    (default 1.15)
#   ORACLE_SEED   sampler seed                       (default 42)
#   ORACLE_TOK    tokenizer file      (default models/oracle-tok.bin)
#
# STEPS now counts BPE tokens, not characters, so a token is roughly three
# characters of text and 200 tokens is a longer sample than the old 300 chars.

import "std/random" as rnd
import "std/text" as text
import "std/float" as float
import "src/model.tw" as model
import "src/tokenizer.tw" as tok
import "src/quant.tw" as quant

# ── Decoding settings, from the environment with sensible defaults ───────────
#
# The value is a string, so it is parsed with float.f64_of_str; an unparseable
# value falls back to the default rather than aborting a generation.
fn env_num(name, dflt) {
  match env(name) {
    Some(v) => if len(v) == 0 { dflt } else {
      match float.f64_of_str(v) {
        Some(x) => x,
        None => dflt
      }
    },
    None => dflt
  }
}

let STEPS = int(env_num("ORACLE_STEPS", 200.0))
let TEMP = env_num("ORACLE_TEMP", 0.8)
let TOPK = int(env_num("ORACLE_TOPK", 40.0))
let NUCLEUS = env_num("ORACLE_TOPP", 0.95)
let REP = env_num("ORACLE_REP", 1.15)
let SEED = int(env_num("ORACLE_SEED", 42.0))

# ── Arguments ────────────────────────────────────────────────────────────────
let av = args()
let prompt = if len(av) > 1 { av[1] } else { "The " }
let path = if len(av) > 2 { av[2] } else { "models/oracle.bin" }

# ── Load ─────────────────────────────────────────────────────────────────────
#
# A checkpoint is int8 when it carries a `quant` field; its packed weights are
# rebuilt into QTensors so `linear` runs the int8 kernel.
fn has_field(rec, name) {
  let cols = columns(rec)
  let found = false
  for i in range(len(cols)) {
    if text.equal(cols[i], name) { found = true }
  }
  found
}

let ckpt = load(path)
let cfg = ckpt.cfg
let is_int8 = has_field(ckpt, "quant")
let p = if is_int8 { quant.rebuild_params(ckpt.p) } else { ckpt.p }
if is_int8 {
  print("[int8 checkpoint]")
}

# The tokenizer travels in its own file, learned and saved by train.tw.
fn tok_path() {
  match env("ORACLE_TOK") {
    Some(v) => if len(v) == 0 { "models/oracle-tok.bin" } else { v },
    None => "models/oracle-tok.bin"
  }
}
let tk = tok.load_tok(tok_path())

# ── Sample ───────────────────────────────────────────────────────────────────
let ids = tok.encode(tk, prompt)
if len(ids) == 0 {
  print("empty prompt; sampling from an empty context")
}
let r = rnd.new_rng(SEED)
let cont = model.generate_sampled(p, ids, STEPS, cfg, r, TEMP, TOPK, NUCLEUS, REP)
print(tok.decode(tk, cont))
