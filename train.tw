# train.tw: train Oracle on the corpus and save a checkpoint.
#
# Run it from the repository root:
#
#   twill run train.tw
#
# It reads data/corpus.txt, builds a character-level vocabulary, trains the
# decoder in src/model.tw with Adam over random windows of the corpus, prints
# the loss as it goes, and saves the trained weights (together with the config
# and the vocabulary) to models/oracle.bin. generate.tw loads that file back.
#
# Everything here is a pure function of the two seeds below, so a second run
# reproduces the first: seed() fixes the weight initialisation, and the Rng from
# std/random fixes which windows each step trains on.

import "std/optim" as optim
import "std/random" as rnd
import "std/io" as io
import "std/text" as text
import "src/model.tw" as model
import "src/tokenizer.tw" as tok

# ── Hyperparameters ──────────────────────────────────────────────────────────
#
# Sized to train on a laptop CPU inside about half an hour and still leave the
# corpus (about 1.1 MB) far larger than the model, so the text it learns is
# structure and not a memorised copy. RoPE carries position, so T is the training
# context, not a runtime ceiling: generation runs past it.
let DIM = 192        # residual-stream width
let HEADS = 6        # attention heads (DIM must divide by HEADS)
let DEPTH = 4        # stacked decoder blocks
let T = 128          # context length in characters
let BATCH = 12       # windows per step
let STEPS = 650      # optimiser steps
let LR = 0.0007      # peak Adam learning rate
let WARMUP = 60      # steps to ramp the learning rate up over

# The committed corpus is the full ~1.1 MB tiny-shakespeare. Character-level
# tokenisation of the whole file in the interpreter is the slow part of a run, so
# training reads a prefix: a deterministic slice that keeps the wall clock inside
# the budget while still giving the sampler several times the old 60 KB to draw
# windows from. Raise it for a longer, slower run; the derivation stays honest
# because the prefix is a fixed function of the committed file.
let TRAIN_CHARS = 200000

seed(1)

# ── Corpus and tokeniser ─────────────────────────────────────────────────────
let full = io.read_text_or("data/corpus.txt", "")
if len(full) == 0 {
  print("error: data/corpus.txt is empty or missing; run scripts/fetch_corpus.sh")
}
let corpus = if text.char_len(full) > TRAIN_CHARS { text.slice(full, 0, TRAIN_CHARS) } else { full }
let vocab = tok.build(corpus)
let data = tok.encode_corpus(vocab, corpus)
print("corpus", len(corpus), "chars,", vocab.vocab, "distinct")

# ── Model ────────────────────────────────────────────────────────────────────
let cfg = model.config(vocab.vocab, DIM, HEADS, DEPTH, T)
let p = model.params(cfg, "xavier")
print("model", model.num_params(p), "parameters")

# ── One minibatch of random windows ──────────────────────────────────────────
#
# Each window is T input characters and the same characters shifted left by one,
# so position t is asked to predict t+1. `int` coerces the systems-mode integer
# the Rng returns into a numeric scalar the tensor builder accepts.
fn make_batch(r, data, T, B) {
  let xs = list()
  let ys = list()
  let n = len(data)
  for b in range(B) {
    let s = int(rnd.int_range(r, 0, n - T - 1))
    let xi = list()
    let yi = list()
    for j in range(T) {
      xi = append(xi, s + j)
      yi = append(yi, s + j + 1)
    }
    xs = append(xs, gather(data, tensor(xi)))
    ys = append(ys, gather(data, tensor(yi)))
  }
  list(xs, ys)
}

# A linear warmup then a gentle linear decay, so the first few steps do not
# diverge and the last few settle.
fn lr_at(step) {
  if step < WARMUP {
    LR * (step + 1) / WARMUP
  } else {
    let frac = (STEPS - step) / (STEPS - WARMUP)
    LR * (0.1 + 0.9 * frac)
  }
}

# ── Train ────────────────────────────────────────────────────────────────────
let r = rnd.new_rng(7)
let m = optim.zeros_like(p)
let v = optim.zeros_like(p)
for step in range(STEPS) {
  let b = make_batch(r, data, T, BATCH)
  let g = grad(fn(w) = model.batch_loss(w, b[0], b[1], cfg))(p)
  let out = optim.adam_step(p, g, m, v, step + 1, lr_at(step), 0.9, 0.999, 0.00000001)
  p = out[0]
  m = out[1]
  v = out[2]
  if step % 20 == 0 {
    print("step", step, "loss", model.batch_loss(p, b[0], b[1], cfg))
  }
}

# ── Save ─────────────────────────────────────────────────────────────────────
#
# The checkpoint carries everything generate.tw needs: the weights, the config
# it was trained under, and the character codes so ids decode to the same text.
let ckpt = { p: p, cfg: cfg, codes: vocab.codes }
save(ckpt, "models/oracle.bin")
print("saved models/oracle.bin")

# ── A quick greedy sample, as a sanity check ─────────────────────────────────
#
# Generated with the KV-cache for 160 characters, which runs the context past the
# 128 it trained on: RoPE has no table to run off the end of, so this both sanity
# checks the weights and demonstrates that the cap is gone.
let prompt = "The "
let ids = tok.encode(tok.to_id_of(vocab.codes), prompt)
let cont = model.generate_cached(p, ids, 160, cfg)
print("sample:")
print(tok.decode(vocab.codes, cont))
