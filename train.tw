# train.tw: train Oracle on the corpus and save a checkpoint.
#
# Run it from the repository root:
#
#   twill run train.tw
#
# It reads data/corpus.txt, learns a byte-level BPE tokenizer on a prefix of it
# (src/tokenizer.tw), encodes the corpus to token ids, trains the decoder in
# src/model.tw with Adam over random windows of those ids, prints the loss as it
# goes, and saves two files: the trained weights and config to models/oracle.bin,
# and the learned tokenizer (vocab + merges) to models/oracle-tok.bin.
# generate.tw and bench.tw load both back.
#
# Everything here is a pure function of the two seeds below, so a second run
# reproduces the first: seed() fixes the weight initialisation, and the Rng from
# std/random fixes which windows each step trains on. The tokenizer is itself
# deterministic (ties broken by the lowest pair key), so its merges reproduce too.

import "std/optim" as optim
import "std/random" as rnd
import "std/io" as io
import "std/text" as text
import "src/model.tw" as model
import "src/tokenizer.tw" as tok

# ── Hyperparameters ──────────────────────────────────────────────────────────
#
# The v0.6.0 base config. Byte-level BPE shortens the corpus by about 2.8x, so a
# 256-token context covers roughly 700 characters of text, far more than the
# old 128-character window, and the model is about 3.4M parameters, up from
# 1.79M. Sized so the whole run (tokenizer training, encoding, and optimisation)
# stays under about 35 minutes on a laptop CPU. RoPE carries position, so T is
# the training context, not a runtime ceiling: generation runs past it.
#
# BATCH * T is 1536 tokens per step, the same throughput the v0.5.0 char model
# trained under (12 * 128), so each step does a comparable amount of work on a
# wider context.
let VOCAB = 1024     # BPE vocabulary target (256 byte tokens + 768 merges)
let DIM = 256        # residual-stream width
let HEADS = 8        # attention heads (DIM must divide by HEADS)
let DEPTH = 4        # stacked decoder blocks
let T = 256          # context length in BPE tokens
let BATCH = 6        # windows per step
let STEPS = 280      # optimiser steps
let LR = 0.0006      # peak Adam learning rate
let WARMUP = 40      # steps to ramp the learning rate up over

# The committed corpus is the full ~1.1 MB tiny-shakespeare. The tokenizer learns
# its merges on this deterministic prefix and the model trains on the same prefix
# encoded to ids; the held-out slice bench.tw scores lies past it. A prefix keeps
# the tokenizer-training wall clock bounded (it is the slow part of a run) while
# still giving the sampler tens of thousands of tokens to draw windows from.
let TRAIN_CHARS = 250000

seed(1)

# ── Corpus and tokeniser ─────────────────────────────────────────────────────
let full = io.read_text_or("data/corpus.txt", "")
if len(full) == 0 {
  print("error: data/corpus.txt is empty or missing; run scripts/fetch_corpus.sh")
}
let corpus = if len(full) > TRAIN_CHARS { text.slice(full, 0, TRAIN_CHARS) } else { full }
print("learning BPE merges on", len(corpus), "chars, target vocab", VOCAB, "...")
let tk = tok.train_from_corpus(corpus, VOCAB)
tok.save_tok(tk, "models/oracle-tok.bin")
let data = tok.encode(tk, corpus)
print("tokenizer vocab", tk.vocab, "merges", len(tk.merges))
print("corpus", len(corpus), "chars ->", len(data), "tokens (",
  f64(len(corpus)) / f64(len(data)), "chars/token )")

# ── Model ────────────────────────────────────────────────────────────────────
let cfg = model.config(tk.vocab, DIM, HEADS, DEPTH, T)
let p = model.params(cfg, "xavier")
print("model", model.num_params(p), "parameters")

# ── One minibatch of random windows ──────────────────────────────────────────
#
# Each window is T input tokens and the same tokens shifted left by one, so
# position t is asked to predict t+1. `int` coerces the systems-mode integer the
# Rng returns into a numeric scalar the tensor builder accepts.
fn make_batch(r, data, T, B) {
  let xs = list()
  let ys = list()
  let n = len(data)
  for b in range(B) {
    let s = int(rnd.int_range(r, 0, n - T - 1))
    let xi = list()
    let yi = list()
    for j in range(T) {
      xi = append(xi, s + j)
      yi = append(yi, s + j + 1)
    }
    xs = append(xs, gather(data, tensor(xi)))
    ys = append(ys, gather(data, tensor(yi)))
  }
  list(xs, ys)
}

# A linear warmup then a gentle linear decay, so the first few steps do not
# diverge and the last few settle.
fn lr_at(step) {
  if step < WARMUP {
    LR * (step + 1) / WARMUP
  } else {
    let frac = (STEPS - step) / (STEPS - WARMUP)
    LR * (0.1 + 0.9 * frac)
  }
}

# ── Train ────────────────────────────────────────────────────────────────────
let r = rnd.new_rng(7)
let m = optim.zeros_like(p)
let v = optim.zeros_like(p)
for step in range(STEPS) {
  let b = make_batch(r, data, T, BATCH)
  let g = grad(fn(w) = model.batch_loss(w, b[0], b[1], cfg))(p)
  let out = optim.adam_step(p, g, m, v, step + 1, lr_at(step), 0.9, 0.999, 0.00000001)
  p = out[0]
  m = out[1]
  v = out[2]
  if step % 20 == 0 {
    print("step", step, "loss", model.batch_loss(p, b[0], b[1], cfg))
  }
}

# ── Save ─────────────────────────────────────────────────────────────────────
#
# The checkpoint carries the weights and the config it was trained under. The
# tokenizer lives in its own file (saved above), so generate.tw and bench.tw load
# the two together: the checkpoint has no vocabulary of its own any more.
let ckpt = { p: p, cfg: cfg }
save(ckpt, "models/oracle.bin")
print("saved models/oracle.bin and models/oracle-tok.bin")

# ── A quick greedy sample, as a sanity check ─────────────────────────────────
#
# Generated with the KV-cache for 60 tokens, which runs the context past nothing
# in particular here but exercises the cached decode path on the fresh weights.
let prompt = "The "
let ids = tok.encode(tk, prompt)
let cont = model.generate_cached(p, ids, 60, cfg)
print("sample:")
print(tok.decode(tk, cont))
