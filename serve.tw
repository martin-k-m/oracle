# serve.tw: a persistent Oracle model host, driven over stdin/stdout.
#
# chat.tw loads the model once and talks to a person; this loads the model once
# and talks to a program (scripts/serve.py). It keeps the conversation in memory
# and streams each reply token by token, so the web console answers many requests
# without paying the model-load cost again. It is not interactive and prints no
# banner: every byte on stdout is part of the wire protocol below.
#
# Protocol, read with read_line (twill 1.18.3):
#   client -> host, one command per line:
#     RESET                     forget the conversation, then emit <end>
#     MSG                       a message follows: read lines until a line that
#                               is exactly __ORACLE_EOM__, join them with "\n",
#                               answer it, and stream the reply
#   host -> client, framed so code and newlines survive intact:
#     <SOH><byte-count><STX><delta>   one streamed chunk of reply text
#     <EOT>                           end of this reply (also the RESET ack)
#   SOH, STX and EOT are the control bytes 1, 2 and 4, which do not occur in the
#   model's text output. On stdin EOF the host exits.

import "std/random" as rnd
import "std/text" as text
import "std/float" as float
import "src/qwen.tw" as qwen
import "src/qwen_tok.tw" as qt

fn env_num(name, dflt) {
  match env(name) {
    Some(v) => if len(v) == 0 { dflt } else {
      match float.f64_of_str(v) {
        Some(x) => x,
        None => dflt
      }
    },
    None => dflt
  }
}

let STEPS = int(env_num("ORACLE_STEPS", 320.0))
let TEMP = env_num("ORACLE_TEMP", 0.3)
let TOPK = int(env_num("ORACLE_TOPK", 20.0))
let NUCLEUS = env_num("ORACLE_TOPP", 0.9)
let REP = env_num("ORACLE_REP", 1.0)
let SEED = int(env_num("ORACLE_SEED", 0.0))

fn model_dir() {
  match env("ORACLE_QWEN_DIR") {
    Some(d) => if len(d) == 0 { "models/qwen" } else { str(d) },
    None => "models/qwen"
  }
}

# The three framing bytes, and the message terminator the client sends.
let SOH = chr(1)
let STX = chr(2)
let EOT = chr(4)
let EOM = "__ORACLE_EOM__"

let dir = model_dir()
let g = qwen.load_qwen(dir + "/qwen-int8.bin")
let q = qt.load_qwen_tok(dir + "/qwen-tok.bin")
let r = rnd.new_rng(SEED)

# A MSG carries a parameter line, "<temp> <steps>", so each request can set its
# own creativity and length. A missing or unparseable field falls back to the
# server's startup default, so an empty line is a valid "use the defaults".
fn parse_params(line) {
  let n = len(line)
  let i = 0
  while i < n and line[i] != 32 {
    i = i + 1
  }
  let a = text.slice(line, 0, i)
  let b = if i < n { text.slice(line, i + 1, n) } else { "" }
  let temp = match float.f64_of_str(a) { Some(x) => x, None => TEMP }
  let steps = match float.f64_of_str(b) { Some(x) => int(x), None => STEPS }
  { temp: temp, steps: steps }
}

# Read the body of a MSG: every line up to the terminator, rejoined with the
# newlines the client split on.
fn read_body() {
  let acc = ""
  let first = true
  let going = true
  while going {
    match read_line() {
      None => { going = false },
      Some(line) => {
        if line == EOM {
          going = false
        } else {
          if first {
            acc = line
            first = false
          } else {
            acc = acc + "\n" + line
          }
        }
      }
    }
  }
  acc
}

let turns = list()
let running = true
while running {
  match read_line() {
    None => { running = false },
    Some(cmd) => {
      if cmd == "RESET" {
        turns = list()
        write_out(EOT)
      } else {
        if cmd == "MSG" {
          let pp = parse_params(match read_line() { Some(l) => l, None => "" })
          let body = read_body()
          turns = append(turns, { role: "user", text: body })
          let ids = qt.chat_ids(q, turns)
          let shown = 0
          let reply = qwen.generate_stream(g, ids, pp.steps, r, pp.temp, TOPK, NUCLEUS, REP, fn(rep) {
            let full = qt.decode(q, tensor(rep))
            if len(full) > shown {
              let delta = text.slice(full, shown, len(full))
              write_out(SOH + str(len(delta)) + STX + delta)
              shown = len(full)
            }
            rep
          })
          turns = append(turns, { role: "assistant", text: qt.decode(q, tensor(reply)) })
          write_out(EOT)
        }
      }
    }
  }
}
