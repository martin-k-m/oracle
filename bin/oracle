#!/usr/bin/env bash
# oracle: one entrypoint for training, generating, quantizing, and benchmarking.
#
# This is thin convenience over the twill commands. Everything it does you can
# do by calling `twill` yourself. Run it from anywhere; it locates the
# repository from its own path, so the checkpoints and sources are always found.
#
# It finds the twill binary in this order:
#   1. $TWILL, if set (an explicit path to the binary)
#   2. `twill` on your PATH
#   3. $(go env GOBIN)/twill or $(go env GOPATH)/bin/twill
#
# If none of those resolve, it prints the one install line you need and exits.

set -euo pipefail

# Resolve the repository root from this script's location (bin/oracle -> ..).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
ROOT="$(cd -P "$BIN_DIR/.." >/dev/null 2>&1 && pwd)"

find_twill() {
  if [ -n "${TWILL:-}" ] && [ -x "${TWILL}" ]; then
    echo "$TWILL"; return 0
  fi
  if command -v twill >/dev/null 2>&1; then
    command -v twill; return 0
  fi
  if command -v go >/dev/null 2>&1; then
    local gobin
    gobin="$(go env GOBIN 2>/dev/null || true)"
    [ -n "$gobin" ] && [ -x "$gobin/twill" ] && { echo "$gobin/twill"; return 0; }
    local gopath
    gopath="$(go env GOPATH 2>/dev/null || true)"
    [ -n "$gopath" ] && [ -x "$gopath/bin/twill" ] && { echo "$gopath/bin/twill"; return 0; }
  fi
  return 1
}

if ! TW="$(find_twill)"; then
  cat >&2 <<'EOF'
oracle: could not find the twill binary.

Install the pinned toolchain and put your GOBIN on PATH:

  go install github.com/twill-lang/twill/cmd/twill@v1.18.3

Then re-run, or point oracle straight at the binary:

  TWILL=/path/to/twill oracle <command>
EOF
  exit 127
fi

usage() {
  cat <<EOF
oracle: a small language model written entirely in Twill.

Usage:
  oracle train                 train the model, write models/oracle.bin
  oracle generate "<prompt>"   sample a continuation from the checkpoint
  oracle generate "<prompt>" <checkpoint>
                               sample from a specific checkpoint (e.g. int8)
  oracle quantize              pack models/oracle.bin to models/oracle-int8.bin
  oracle bench                 measure size, speed, memory, and quality

  oracle fetch-gpt2            download and convert the open GPT-2 124M weights
  oracle quantize-gpt2         pack the GPT-2 weights to int8 (smaller, leaner)
  oracle fetch-qwen [SIZE]     download and convert Qwen2.5-Coder (0.5B default, or 1.5B, 3B)
  oracle code "<prompt>"       ask the Qwen coder to write code (instruction-following)
  oracle chat                  an interactive, streaming chat with the Qwen coder
  oracle gpt2 "<prompt>"       continue a prompt with the GPT-2 runtime (real
                               English; writes short emails, weak at code)
                               (fp64 by default; --int8 uses smaller, slower weights)
  oracle check                 static shape-check every .tw file
  oracle test                  run the tokenizer round-trip tests
  oracle help                  show this message

Generate options (flags, before or after the prompt):
  --steps N     tokens to generate               (default 200)
  --temp F      softmax temperature, lower firmer (default 0.8)
  --topk N      keep the top-k tokens, 0 for off  (default 40)
  --topp F      nucleus (top-p) mass, 1.0 for off (default 0.95)
  --rep F       repetition penalty, 1.0 for off   (default 1.15)
  --seed N      sampler seed                      (default 42)

  Context is unbounded: RoPE positions replace the old learned table, so a
  long prompt and a large --steps run past the 256-token training context.

Environment:
  TWILL        path to the twill binary (otherwise found on PATH or via go)
  MATMUL=fast  pass to bench to select the fast matmul microkernels

Using twill at: $TW
EOF
}

cd "$ROOT"
cmd="${1:-help}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
  train)
    exec "$TW" run train.tw ;;
  generate)
    # Parse decoding flags into the ORACLE_* environment generate.tw reads, and
    # collect the up-to-two positionals (prompt, then optional checkpoint path).
    positionals=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --steps) export ORACLE_STEPS="$2"; shift 2 ;;
        --temp)  export ORACLE_TEMP="$2";  shift 2 ;;
        --topk)  export ORACLE_TOPK="$2";  shift 2 ;;
        --topp)  export ORACLE_TOPP="$2";  shift 2 ;;
        --rep)   export ORACLE_REP="$2";   shift 2 ;;
        --seed)  export ORACLE_SEED="$2";  shift 2 ;;
        --) shift; while [ $# -gt 0 ]; do positionals+=("$1"); shift; done ;;
        *) positionals+=("$1"); shift ;;
      esac
    done
    if [ ${#positionals[@]} -lt 1 ]; then
      echo "oracle generate: a prompt is required, e.g. oracle generate \"To be\"" >&2
      exit 2
    fi
    prompt="${positionals[0]}"
    ckpt="${positionals[1]:-models/oracle.bin}"
    exec "$TW" run generate.tw "$prompt" "$ckpt" ;;
  fetch-gpt2)
    exec bash "$ROOT/scripts/fetch_gpt2.sh" ;;
  fetch-qwen)
    exec bash "$ROOT/scripts/fetch_qwen.sh" "$@" ;;
  chat)
    if [ ! -s "$ROOT/models/qwen/qwen-int8.bin" ]; then
      echo "oracle chat: the Qwen weights are not present. Run 'oracle fetch-qwen' first." >&2
      exit 3
    fi
    exec "$TW" run chat.tw ;;
  code)
    if [ ! -s "$ROOT/models/qwen/qwen-int8.bin" ]; then
      echo "oracle code: the Qwen weights are not present." >&2
      echo "Run once to download and convert them (needs curl and python3 with numpy):" >&2
      echo "  oracle fetch-qwen" >&2
      exit 3
    fi
    positionals=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --steps) export ORACLE_STEPS="$2"; shift 2 ;;
        --temp)  export ORACLE_TEMP="$2";  shift 2 ;;
        --topk)  export ORACLE_TOPK="$2";  shift 2 ;;
        --topp)  export ORACLE_TOPP="$2";  shift 2 ;;
        --rep)   export ORACLE_REP="$2";   shift 2 ;;
        --seed)  export ORACLE_SEED="$2";  shift 2 ;;
        --) shift; while [ $# -gt 0 ]; do positionals+=("$1"); shift; done ;;
        *) positionals+=("$1"); shift ;;
      esac
    done
    if [ ${#positionals[@]} -lt 1 ]; then
      echo "oracle code: a prompt is required, e.g. oracle code \"Write a function to reverse a string.\"" >&2
      exit 2
    fi
    exec "$TW" run qwen_gen.tw "${positionals[0]}" ;;
  quantize-gpt2)
    if [ ! -s "$ROOT/models/gpt2/gpt2.bin" ]; then
      echo "oracle quantize-gpt2: run 'oracle fetch-gpt2' first." >&2
      exit 3
    fi
    exec "$TW" run quantize_gpt2.tw ;;
  gpt2)
    if [ ! -s "$ROOT/models/gpt2/gpt2.bin" ]; then
      echo "oracle gpt2: the GPT-2 weights are not present." >&2
      echo "Run once to download and convert them (needs curl and python3 with numpy):" >&2
      echo "  oracle fetch-gpt2" >&2
      exit 3
    fi
    force_fp=0
    positionals=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --steps) export ORACLE_STEPS="$2"; shift 2 ;;
        --temp)  export ORACLE_TEMP="$2";  shift 2 ;;
        --topk)  export ORACLE_TOPK="$2";  shift 2 ;;
        --topp)  export ORACLE_TOPP="$2";  shift 2 ;;
        --rep)   export ORACLE_REP="$2";   shift 2 ;;
        --seed)  export ORACLE_SEED="$2";  shift 2 ;;
        --int8)  want_int8=1; shift ;;
        --) shift; while [ $# -gt 0 ]; do positionals+=("$1"); shift; done ;;
        *) positionals+=("$1"); shift ;;
      esac
    done
    if [ ${#positionals[@]} -lt 1 ]; then
      echo "oracle gpt2: a prompt is required, e.g. oracle gpt2 \"Dear team,\"" >&2
      exit 2
    fi
    # fp64 is the default because it is faster: in twill 1.18.3 the int8 model
    # reconstructs its kernels at load, which is slower than it is worth for
    # inference. --int8 opts into the smaller weights if disk matters more.
    if [ "${want_int8:-0}" -eq 1 ]; then
      if [ ! -s "$ROOT/models/gpt2/gpt2-int8.bin" ]; then
        echo "oracle gpt2 --int8: run 'oracle quantize-gpt2' first." >&2
        exit 3
      fi
      export ORACLE_GPT2_INT8=1
    fi
    exec "$TW" run gpt2_gen.tw "${positionals[0]}" ;;
  quantize)
    exec "$TW" run quantize.tw ;;
  bench)
    exec env TWILL_MATMUL="${MATMUL:-}" "$TW" run bench.tw ;;
  check)
    exec "$TW" check src/model.tw src/tokenizer.tw src/quant.tw src/gpt2.tw src/gpt2_tok.tw src/gpt2_quant.tw src/qwen.tw src/qwen_tok.tw train.tw generate.tw quantize.tw bench.tw gpt2_gen.tw quantize_gpt2.tw qwen_gen.tw chat.tw tests/tokenizer_test.tw ;;
  test)
    exec "$TW" run tests/tokenizer_test.tw ;;
  help|-h|--help)
    usage ;;
  *)
    echo "oracle: unknown command '$cmd'" >&2
    usage >&2
    exit 2 ;;
esac
