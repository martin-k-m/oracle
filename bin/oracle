#!/usr/bin/env bash
# oracle: one entrypoint for training, generating, quantizing, and benchmarking.
#
# This is thin convenience over the twill commands. Everything it does you can
# do by calling `twill` yourself. Run it from anywhere; it locates the
# repository from its own path, so the checkpoints and sources are always found.
#
# It finds the twill binary in this order:
#   1. $TWILL, if set (an explicit path to the binary)
#   2. `twill` on your PATH
#   3. $(go env GOBIN)/twill or $(go env GOPATH)/bin/twill
#
# If none of those resolve, it prints the one install line you need and exits.

set -euo pipefail

# Resolve the repository root from this script's location (bin/oracle -> ..).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
ROOT="$(cd -P "$BIN_DIR/.." >/dev/null 2>&1 && pwd)"

find_twill() {
  if [ -n "${TWILL:-}" ] && [ -x "${TWILL}" ]; then
    echo "$TWILL"; return 0
  fi
  if command -v twill >/dev/null 2>&1; then
    command -v twill; return 0
  fi
  if command -v go >/dev/null 2>&1; then
    local gobin
    gobin="$(go env GOBIN 2>/dev/null || true)"
    [ -n "$gobin" ] && [ -x "$gobin/twill" ] && { echo "$gobin/twill"; return 0; }
    local gopath
    gopath="$(go env GOPATH 2>/dev/null || true)"
    [ -n "$gopath" ] && [ -x "$gopath/bin/twill" ] && { echo "$gopath/bin/twill"; return 0; }
  fi
  return 1
}

# Resolve a --model value to a model directory: a size like 1.5B maps to
# models/qwen-<size> (0.5B is models/qwen), and anything else is a directory
# path. With no value, pick the most capable model that is installed, so a user
# who fetched 1.5B gets it without passing a flag.
model_dir() {
  case "$1" in
    0.5B) echo "models/qwen" ;;
    1.5B|3B|7B|14B|32B) echo "models/qwen-$1" ;;
    "")
      local d
      for d in models/qwen-32B models/qwen-14B models/qwen-7B models/qwen-3B models/qwen-1.5B models/qwen; do
        if [ -s "$ROOT/$d/qwen-int8.bin" ]; then echo "$d"; return; fi
      done
      echo "models/qwen"
      ;;
    *) echo "$1" ;;
  esac
}

# Run the Qwen coder for a task. $1 is the task name (code, explain, ...), $2 a
# fixed instruction (empty means take the prompt from the arguments, as `oracle
# code` does); the rest are flags and files. Files, and piped stdin when there
# are none, are given as context.
#
# If ORACLE_SERVER (or --server URL) points at a running `oracle serve`, the work
# is sent there over HTTP so the already-loaded model answers it, instead of
# starting twill and loading the weights again (about two seconds a call). If the
# server cannot be reached it falls back to running the model locally.
qwen_run() {
  local task="$1"; shift
  local fixed="$1"; shift
  local files=() mval="" positionals=() server="${ORACLE_SERVER:-}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --steps)  export ORACLE_STEPS="$2"; shift 2 ;;
      --temp)   export ORACLE_TEMP="$2";  shift 2 ;;
      --topk)   export ORACLE_TOPK="$2";  shift 2 ;;
      --topp)   export ORACLE_TOPP="$2";  shift 2 ;;
      --rep)    export ORACLE_REP="$2";   shift 2 ;;
      --seed)   export ORACLE_SEED="$2";  shift 2 ;;
      --file)   files+=("$2"); shift 2 ;;
      --model)  mval="$2"; shift 2 ;;
      --server) server="$2"; shift 2 ;;
      --) shift; while [ $# -gt 0 ]; do positionals+=("$1"); shift; done ;;
      *) positionals+=("$1"); shift ;;
    esac
  done
  local f
  for f in ${files[@]+"${files[@]}"}; do
    if [ ! -f "$f" ]; then
      echo "oracle: file not found: $f" >&2
      exit 3
    fi
  done
  # Read piped stdin as context when no file was given, exactly as before.
  local tmp=""
  if [ ${#files[@]} -eq 0 ] && [ ! -t 0 ]; then
    tmp="$(mktemp)"
    cat > "$tmp"
    if [ -s "$tmp" ]; then files+=("$tmp"); else rm -f "$tmp"; tmp=""; fi
  fi

  # Server path: hand the task to a live model. The server applies the task's
  # instruction itself, so it gets the user's own words as the prompt and the
  # gathered files as the code.
  if [ -n "$server" ]; then
    local py="${PYTHON:-python3}"
    local user_prompt="${positionals[*]:-}"
    local codefile; codefile="$(mktemp)"
    local first=1
    for f in ${files[@]+"${files[@]}"}; do
      [ $first -eq 1 ] && first=0 || printf '\n\n' >> "$codefile"
      printf '===== %s =====\n' "$f" >> "$codefile"
      cat "$f" >> "$codefile"
    done
    local rc=0
    "$py" "$ROOT/scripts/client.py" "$server" "$task" "$user_prompt" < "$codefile" || rc=$?
    rm -f "$codefile"
    if [ $rc -ne 7 ]; then
      [ -n "$tmp" ] && rm -f "$tmp"
      exit $rc
    fi
    echo "oracle: server at $server unreachable, running locally." >&2
  fi

  # Local path: load the model and run qwen_gen.tw.
  local mdir; mdir="$(model_dir "$mval")"
  if [ ! -s "$ROOT/$mdir/qwen-int8.bin" ]; then
    echo "oracle: the Qwen weights are not present at $mdir." >&2
    echo "Run once to download and convert them:  oracle fetch-qwen ${mval:-0.5B}" >&2
    exit 3
  fi
  export ORACLE_QWEN_DIR="$mdir"
  local prompt="$fixed"
  if [ -z "$prompt" ]; then
    if [ ${#positionals[@]} -lt 1 ]; then
      echo "oracle: a prompt is required." >&2
      exit 2
    fi
    prompt="${positionals[0]}"
  elif [ ${#positionals[@]} -gt 0 ]; then
    # A fixed-instruction task (explain, review, fix, ...) may take extra
    # guidance as trailing words, e.g. `oracle review --file x.py "focus on
    # error handling"` or `oracle fix --file x.py "IndexError on empty input"`.
    prompt="$fixed"$'\n\n'"${positionals[*]}"
  fi
  if [ -n "$tmp" ]; then
    "$TW" run qwen_gen.tw "$prompt" ${files[@]+"${files[@]}"}
    local status=$?
    rm -f "$tmp"
    exit $status
  fi
  exec "$TW" run qwen_gen.tw "$prompt" ${files[@]+"${files[@]}"}
}

if ! TW="$(find_twill)"; then
  cat >&2 <<'EOF'
oracle: could not find the twill binary.

Install the pinned toolchain and put your GOBIN on PATH:

  go install github.com/twill-lang/twill/cmd/twill@v1.18.5

Then re-run, or point oracle straight at the binary:

  TWILL=/path/to/twill oracle <command>
EOF
  exit 127
fi

usage() {
  cat <<EOF
oracle: a small language model written entirely in Twill.

Usage:
  oracle train                 train the model, write models/oracle.bin
  oracle generate "<prompt>"   sample a continuation from the checkpoint
  oracle generate "<prompt>" <checkpoint>
                               sample from a specific checkpoint (e.g. int8)
  oracle quantize              pack models/oracle.bin to models/oracle-int8.bin
  oracle bench                 measure size, speed, memory, and quality

  oracle fetch-gpt2            download and convert the open GPT-2 124M weights
  oracle quantize-gpt2         pack the GPT-2 weights to int8 (smaller, leaner)
  oracle fetch-qwen [SIZE]     download and convert Qwen2.5-Coder (0.5B default, or 1.5B, 3B)
  oracle code "<prompt>" [--file F ...] [--model 1.5B]  ask about code (also reads piped stdin as context)
  oracle explain [--file F]    explain code (from a file or piped stdin)
  oracle review  [--file F]    review code for bugs and improvements
  oracle commit                write a commit message (pipe a diff: git diff | oracle commit)
  oracle fix     [--file F] ["error"]  diagnose and fix a bug (add the error text as a hint)
  oracle tests   [--file F]    write unit tests for the code
  oracle sh      "<request>"   turn a plain request into one shell command
  oracle chat                  interactive chat (/file loads code, /reset clears, /help)
  oracle serve [--port N] [--model 1.5B]  a local web console for these tasks
                               (also a model host: set ORACLE_SERVER to reuse it)
  oracle gpt2 "<prompt>"       continue a prompt with the GPT-2 runtime (real
                               English; writes short emails, weak at code)
                               (fp64 by default; --int8 uses smaller, slower weights)
  oracle check                 static shape-check every .tw file
  oracle test                  run the tokenizer round-trip tests
  oracle help                  show this message

Generate options (flags, before or after the prompt):
  --steps N     tokens to generate               (default 200)
  --temp F      softmax temperature, lower firmer (default 0.8)
  --topk N      keep the top-k tokens, 0 for off  (default 40)
  --topp F      nucleus (top-p) mass, 1.0 for off (default 0.95)
  --rep F       repetition penalty, 1.0 for off   (default 1.15)
  --seed N      sampler seed                      (default 42)

  Context is unbounded: RoPE positions replace the old learned table, so a
  long prompt and a large --steps run past the 256-token training context.

Environment:
  TWILL          path to the twill binary (otherwise found on PATH or via go)
  MATMUL=fast    pass to bench to select the fast matmul microkernels
  ORACLE_SERVER  URL of a running 'oracle serve' (e.g. http://127.0.0.1:8080);
                 code, explain, review, fix, tests, sh and commit send the work
                 there so the model loads once instead of on every call. Also
                 settable per command with --server URL. Falls back to running
                 locally if the server cannot be reached.

Using twill at: $TW
EOF
}

cd "$ROOT"
cmd="${1:-help}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
  train)
    exec "$TW" run train.tw ;;
  generate)
    # Parse decoding flags into the ORACLE_* environment generate.tw reads, and
    # collect the up-to-two positionals (prompt, then optional checkpoint path).
    positionals=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --steps) export ORACLE_STEPS="$2"; shift 2 ;;
        --temp)  export ORACLE_TEMP="$2";  shift 2 ;;
        --topk)  export ORACLE_TOPK="$2";  shift 2 ;;
        --topp)  export ORACLE_TOPP="$2";  shift 2 ;;
        --rep)   export ORACLE_REP="$2";   shift 2 ;;
        --seed)  export ORACLE_SEED="$2";  shift 2 ;;
        --) shift; while [ $# -gt 0 ]; do positionals+=("$1"); shift; done ;;
        *) positionals+=("$1"); shift ;;
      esac
    done
    if [ ${#positionals[@]} -lt 1 ]; then
      echo "oracle generate: a prompt is required, e.g. oracle generate \"To be\"" >&2
      exit 2
    fi
    prompt="${positionals[0]}"
    ckpt="${positionals[1]:-models/oracle.bin}"
    exec "$TW" run generate.tw "$prompt" "$ckpt" ;;
  fetch-gpt2)
    exec bash "$ROOT/scripts/fetch_gpt2.sh" ;;
  fetch-qwen)
    exec bash "$ROOT/scripts/fetch_qwen.sh" "$@" ;;
  chat)
    mval=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --model) mval="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    mdir="$(model_dir "$mval")"
    if [ ! -s "$ROOT/$mdir/qwen-int8.bin" ]; then
      echo "oracle chat: the Qwen weights are not present at $mdir. Run 'oracle fetch-qwen ${mval:-0.5B}' first." >&2
      exit 3
    fi
    export ORACLE_QWEN_DIR="$mdir"
    exec "$TW" run chat.tw ;;
  code)
    qwen_run code "" "$@" ;;
  explain)
    qwen_run explain "Explain what the following code does, clearly and concisely, step by step where it helps." "$@" ;;
  review)
    qwen_run review "Review the following code. Point out bugs, edge cases, and concrete improvements, most important first. Be specific and brief." "$@" ;;
  commit)
    qwen_run commit "Write a git commit message for the following diff. Use a short imperative subject line under about sixty characters, then a blank line, then a brief body of what changed and why. Output only the commit message." "$@" ;;
  fix)
    qwen_run fix "Find and fix the bug in the following code. First name the bug in one or two sentences, then give the corrected code. If an error message or description is provided, use it to locate the problem." "$@" ;;
  tests)
    qwen_run tests "Write focused unit tests for the following code. Cover the main behavior and the important edge cases, using the language's standard test style. Output only the test code." "$@" ;;
  sh)
    qwen_run sh "Give a single shell command for macOS or Linux that does what is asked. Output only the command on one line, with no explanation and no code fence." "$@" ;;
  quantize-gpt2)
    if [ ! -s "$ROOT/models/gpt2/gpt2.bin" ]; then
      echo "oracle quantize-gpt2: run 'oracle fetch-gpt2' first." >&2
      exit 3
    fi
    exec "$TW" run quantize_gpt2.tw ;;
  gpt2)
    if [ ! -s "$ROOT/models/gpt2/gpt2.bin" ]; then
      echo "oracle gpt2: the GPT-2 weights are not present." >&2
      echo "Run once to download and convert them (needs curl and python3 with numpy):" >&2
      echo "  oracle fetch-gpt2" >&2
      exit 3
    fi
    force_fp=0
    positionals=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --steps) export ORACLE_STEPS="$2"; shift 2 ;;
        --temp)  export ORACLE_TEMP="$2";  shift 2 ;;
        --topk)  export ORACLE_TOPK="$2";  shift 2 ;;
        --topp)  export ORACLE_TOPP="$2";  shift 2 ;;
        --rep)   export ORACLE_REP="$2";   shift 2 ;;
        --seed)  export ORACLE_SEED="$2";  shift 2 ;;
        --int8)  want_int8=1; shift ;;
        --) shift; while [ $# -gt 0 ]; do positionals+=("$1"); shift; done ;;
        *) positionals+=("$1"); shift ;;
      esac
    done
    if [ ${#positionals[@]} -lt 1 ]; then
      echo "oracle gpt2: a prompt is required, e.g. oracle gpt2 \"Dear team,\"" >&2
      exit 2
    fi
    # fp64 is the default because it is faster: in twill 1.18.4 the int8 model
    # reconstructs its kernels at load, which is slower than it is worth for
    # inference. --int8 opts into the smaller weights if disk matters more.
    if [ "${want_int8:-0}" -eq 1 ]; then
      if [ ! -s "$ROOT/models/gpt2/gpt2-int8.bin" ]; then
        echo "oracle gpt2 --int8: run 'oracle quantize-gpt2' first." >&2
        exit 3
      fi
      export ORACLE_GPT2_INT8=1
    fi
    exec "$TW" run gpt2_gen.tw "${positionals[0]}" ;;
  quantize)
    exec "$TW" run quantize.tw ;;
  bench)
    exec env TWILL_MATMUL="${MATMUL:-}" "$TW" run bench.tw ;;
  serve)
    # A small local web console over these same tasks. It holds one model live
    # through serve.tw and streams replies. Flags set the environment
    # scripts/serve.py reads; everything else is stdlib Python.
    port="8080" mval=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --port)  port="$2"; shift 2 ;;
        --model) mval="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    py="${PYTHON:-python3}"
    export ORACLE_PORT="$port"
    export TWILL="$TW"   # the server spawns twill; use the one the CLI resolved
    [ -n "$mval" ] && export ORACLE_MODEL="$mval"
    exec "$py" "$ROOT/scripts/serve.py" ;;
  check)
    exec "$TW" check src/model.tw src/tokenizer.tw src/quant.tw src/gpt2.tw src/gpt2_tok.tw src/gpt2_quant.tw src/qwen.tw src/qwen_tok.tw train.tw generate.tw quantize.tw bench.tw gpt2_gen.tw quantize_gpt2.tw qwen_gen.tw chat.tw serve.tw tests/tokenizer_test.tw ;;
  test)
    exec "$TW" run tests/tokenizer_test.tw ;;
  help|-h|--help)
    usage ;;
  *)
    echo "oracle: unknown command '$cmd'" >&2
    usage >&2
    exit 2 ;;
esac
