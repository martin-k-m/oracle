# quant.tw: int8 weight quantisation for Oracle, woven in Twill.
#
# The weights are the bulk of the model, and they are the part that does not
# need f64 to be useful at inference. This module packs every 2-D dense weight
# into int8 with a per-row scale, exactly the symmetric per-output-channel scheme
# twill's `quantize` builtin uses, and it does the packing in plain Twill so the
# checkpoint on disk is small too, not only the model in memory.
#
# Two shapes travel through here:
#
#   a *packed record* {q, scale, rows, cols} is how a weight is stored on disk.
#     `q` is a byte string, one signed int8 code per weight offset by 128 so it
#     rides in a 0..255 byte; `scale` is a 1-D f64 tensor, one per row.
#
#   a *QTensor* is what the packed record becomes in memory for inference. It is
#     built by dequantising the codes back to f64 and handing that to the
#     `quantize` builtin, which repacks it into the int8 kernel's own form. That
#     round trip is exact: the row's largest code is always 127, so the builtin
#     recovers the same scale and the same codes it was given.
#
# Only the dense weights are packed. The token table stays f64: it is read by
# `gather` for the embedding, which needs a real tensor, and it is small. There
# is no position table to carry any more; RoPE places positions inside attention.
# Layernorm gains and biases stay f64 for the same reason, a few hundred numbers
# each.

# Round half away from zero, matching the builtin's math.Round, so the codes
# this packer writes are the codes the builtin would have written.
fn round_awayz(v) = if v >= 0.0 { int(v + 0.5) } else { int(v - 0.5) }

# Pack a 2-D weight [rows, cols] into a {q, scale, rows, cols} record. Each row
# gets its own scale from its own largest magnitude, so a quiet row is not
# crushed by a loud one elsewhere. A row of all zeros gets scale 0 and packs to
# the zero code, which unpacks back to zeros.
fn pack_i8(W) {
  let sh = shape(W)
  let rows = sh[0]
  let cols = sh[1]
  let buf = buf_new(rows * cols)
  let scales = list()
  let i = 0
  while i < rows {
    let ri = W[i]
    let mx = 0.0
    let j = 0
    while j < cols {
      let v = item(ri[j])
      let a = if v < 0.0 { -v } else { v }
      if a > mx { mx = a }
      j = j + 1
    }
    let s = if mx == 0.0 { 0.0 } else { mx / 127.0 }
    scales = append(scales, s)
    let inv = if s == 0.0 { 0.0 } else { 1.0 / s }
    let base = i * cols
    j = 0
    while j < cols {
      let r = round_awayz(item(ri[j]) * inv)
      if r > 127 { r = 127 }
      if r < -128 { r = -128 }
      buf_set8(buf, base + j, r + 128)
      j = j + 1
    }
    i = i + 1
  }
  { q: bytes_to_str(buf), scale: tensor(scales), rows: rows, cols: cols }
}

# Turn a packed record back into a QTensor for inference. The codes unpack to the
# exact f64 weight they encode (code * row scale), and `quantize` repacks that
# into the int8 kernel's form. `linear` then dispatches to the int8 matmul with
# no change at the call site. The row scale is folded in as the weight is read,
# so only one f64 tensor is built rather than an int tensor and a broadcast
# multiply.
#
# The reconstruction is streamed one row at a time. `append` copies its whole
# list on every call, so a single list of every weight's rows*cols values costs
# O((rows*cols)^2) copies and leaves that much transient garbage behind, which is
# what spiked the int8 load far above the steady QTensor footprint. Reconstructing
# per row instead bounds the growing list to one row of `cols` values: each row is
# turned into a [1, cols] tensor, the rows are stacked once with `concat`, and the
# assembled f64 weight is handed to `quantize`. The working set is then one row's
# list plus the one f64 weight being packed, not the whole weight expanded into a
# boxed Twill list at once.
#
# A native builtin that read packed codes straight into a QTensor would remove
# even the one-weight f64 reconstruction; that stays a twill-side follow-up (the
# `quantize` builtin only ingests a full 2-D tensor in v1.18.0), not a limit of
# this format.
fn to_qtensor(rec) {
  let q = rec.q
  let rows = rec.rows
  let cols = rec.cols
  let rowts = list()
  let i = 0
  while i < rows {
    let s = item(rec.scale[i])
    let base = i * cols
    let vals = list()
    let j = 0
    while j < cols {
      vals = append(vals, (q[base + j] - 128) * s)
      j = j + 1
    }
    rowts = append(rowts, reshape(tensor(vals), 1, cols))
    i = i + 1
  }
  quantize(concat(rowts, 0))
}

# ── Tree walkers ─────────────────────────────────────────────────────────────
#
# The model's parameter tree has a fixed shape (see src/model.tw), so these walk
# it by name rather than generically: the token table and the norms are copied as
# f64, and only the six dense weights in each block are packed. Being explicit is
# the honest description of what is and is not quantised.

fn pack_block(b) {
  {
    ln1: b.ln1,
    attn: {
      Wq: pack_i8(b.attn.Wq),
      Wk: pack_i8(b.attn.Wk),
      Wv: pack_i8(b.attn.Wv),
      Wo: pack_i8(b.attn.Wo)
    },
    ln2: b.ln2,
    ff: {
      fc1: { W: pack_i8(b.ff.fc1.W), b: b.ff.fc1.b },
      fc2: { W: pack_i8(b.ff.fc2.W), b: b.ff.fc2.b }
    }
  }
}

# Pack a whole parameter tree. tok and lnf are carried through untouched.
fn pack_params(p) {
  let blocks = list()
  for i in range(len(p.blocks)) {
    blocks = append(blocks, pack_block(p.blocks[i]))
  }
  { tok: p.tok, blocks: blocks, lnf: p.lnf }
}

fn rebuild_block(b) {
  {
    ln1: b.ln1,
    attn: {
      Wq: to_qtensor(b.attn.Wq),
      Wk: to_qtensor(b.attn.Wk),
      Wv: to_qtensor(b.attn.Wv),
      Wo: to_qtensor(b.attn.Wo)
    },
    ln2: b.ln2,
    ff: {
      fc1: { W: to_qtensor(b.ff.fc1.W), b: b.ff.fc1.b },
      fc2: { W: to_qtensor(b.ff.fc2.W), b: b.ff.fc2.b }
    }
  }
}

# Rebuild a parameter tree of QTensors from a packed tree. The result plugs
# straight into src/model.tw's forward pass: `linear` reads a QTensor as the int8
# kernel, so logits(), generate() and generate_sampled() run unchanged on it.
fn rebuild_params(qp) {
  let blocks = list()
  for i in range(len(qp.blocks)) {
    blocks = append(blocks, rebuild_block(qp.blocks[i]))
  }
  { tok: qp.tok, blocks: blocks, lnf: qp.lnf }
}
