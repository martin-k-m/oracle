# tokenizer.tw: character-level tokenisation for Oracle.
#
# The simplest tokeniser that keeps Oracle self-contained: one id per distinct
# character in the corpus. `build` scans a string and returns a vocabulary (the
# id-to-code table and its inverse); `encode` turns text into an id tensor and
# `decode` turns an id stream back into text. The `codes` list is all that has
# to travel with a checkpoint for its ids to mean the same characters later, so
# it is saved next to the weights.

import "std/text" as text

# Scan `corpus` and assign one id per distinct character, in first-seen order.
# Returns a record: `codes` maps id -> character code, `to_id` maps code -> id,
# `vocab` is the alphabet size.
fn build(corpus) {
  let n = text.char_len(corpus)
  let to_id = dict_new()
  let codes = list()
  for i in range(n) {
    let c = text.char_code(corpus, i)
    if dict_has(to_id, c) == false {
      dict_set(to_id, c, len(codes))
      codes = append(codes, c)
    }
  }
  { codes: codes, to_id: to_id, vocab: len(codes) }
}

# Rebuild the code -> id dictionary from a saved `codes` list, so a loaded
# checkpoint can encode a prompt without the original corpus.
fn to_id_of(codes) {
  let to_id = dict_new()
  for i in range(len(codes)) {
    dict_set(to_id, codes[i], i)
  }
  to_id
}

# Encode a string to a 1-D id tensor, given a code -> id dictionary. Characters
# outside the vocabulary are skipped, so a prompt with an unseen character still
# encodes rather than crashing.
fn encode(to_id, s) {
  let ids = list()
  for i in range(text.char_len(s)) {
    let c = text.char_code(s, i)
    if dict_has(to_id, c) {
      ids = append(ids, dict_must(to_id, c))
    }
  }
  tensor(ids)
}

# Encode the whole corpus to a 1-D id tensor, given a vocabulary from `build`.
fn encode_corpus(vocab, corpus) {
  let n = text.char_len(corpus)
  let data = list()
  for i in range(n) {
    data = append(data, dict_must(vocab.to_id, text.char_code(corpus, i)))
  }
  tensor(data)
}

# Decode a 1-D id tensor back to text, given the `codes` table.
fn decode(codes, ids) {
  let s = ""
  for i in range(len(ids)) {
    s = text.concat(s, text.from_byte(codes[int(item(ids[i]))]))
  }
  s
}
