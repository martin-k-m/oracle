# agentlib.tw: the pure parsing and safety logic of the agent, factored out so it
# can be unit-tested without loading a model. agent.tw imports this; the loop, the
# model and the shell execution stay there. Keeping the RUN:/DONE: parser and the
# destructive-command check here, under tests, is what stops a silent regression
# in the part that decides what runs on your computer.

import "std/text" as text

# The first index of `needle` in `hay`, or -1.
fn index_of(hay, needle) {
  let hn = len(hay)
  let nn = len(needle)
  let i = 0
  let found = 0 - 1
  while i + nn <= hn and found < 0 {
    if text.slice(hay, i, i + nn) == needle {
      found = i
    }
    i = i + 1
  }
  found
}

# From `start`, the rest of the line (up to the next newline or the end).
fn rest_of_line(s, start) {
  let n = len(s)
  let i = start
  while i < n and s[i] != 10 {
    i = i + 1
  }
  text.slice(s, start, i)
}

# Strip spaces, tabs and carriage returns from both ends.
fn trim(s) {
  let n = len(s)
  let a = 0
  while a < n and (s[a] == 32 or s[a] == 9 or s[a] == 13) {
    a = a + 1
  }
  let b = n
  while b > a and (s[b - 1] == 32 or s[b - 1] == 9 or s[b - 1] == 13) {
    b = b - 1
  }
  text.slice(s, a, b)
}

# Cap a command's output so a huge result does not flood the model's context.
fn truncate(s, n) {
  if len(s) <= n {
    s
  } else {
    text.slice(s, 0, n) + "\n... (output truncated)"
  }
}

# A rough flag for obviously destructive commands, to warn harder before running.
fn is_dangerous(cmd) {
  index_of(cmd, "rm -r") >= 0 or index_of(cmd, "rm -f") >= 0 or
  index_of(cmd, "mkfs") >= 0 or index_of(cmd, "dd ") >= 0 or
  index_of(cmd, "> /dev/") >= 0 or index_of(cmd, "sudo ") >= 0 or
  index_of(cmd, ":(){") >= 0 or index_of(cmd, "shutdown") >= 0
}

# Parse the model's reply into an action. The first of RUN:/DONE: wins, and the
# argument is the rest of that line, trimmed. { kind: "run" | "done" | "none" }.
fn parse_action(textv) {
  let d = index_of(textv, "DONE:")
  let ru = index_of(textv, "RUN:")
  if d >= 0 and (ru < 0 or d < ru) {
    { kind: "done", arg: trim(rest_of_line(textv, d + 5)) }
  } else {
    if ru >= 0 {
      { kind: "run", arg: trim(rest_of_line(textv, ru + 4)) }
    } else {
      { kind: "none", arg: "" }
    }
  }
}
